architecture-beta
    service users(aws:users)[Users]
    group cloud(cloud)[AWS Cloud]
    group region(aws:region)["us-east-1"] in cloud
    service apigw(aws:api-gateway)[Amazon API Gateway] in region
    service fn(aws:lambda)[AWS Lambda] in region
    service ddb(aws:dynamodb)[Amazon DynamoDB] in region
    users:R --> L:apigw
    apigw:R --> L:fn
    fn:R --> L:ddb
