        { "kind": "pub", "x": 534, "y": 120, "w": 216, "h": 118, "note": ["10.0.2.0/24", "2001:db8:1200:2::/64"] },
        { "kind": "priv", "x": 282, "y": 250, "w": 216, "h": 112, "note": ["10.0.11.0/24", "2001:db8:1200:11::/64"] },
        { "kind": "priv", "x": 534, "y": 250, "w": 216, "h": 112, "note": ["10.0.12.0/24", "2001:db8:1200:12::/64"] }
      ],
