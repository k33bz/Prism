    {
      "id": "v6-nat64",
      "name": "NAT64 and DNS64 for an IPv6-only subnet",
      "desc": "An instance in an IPv6-only subnet reaches a server that has only an IPv4 address. DNS64 on the subnet makes the Route 53 VPC Resolver synthesize an AAAA answer in 64:ff9b::/96, the subnet route table sends that prefix to a NAT gateway in a public subnet, and the NAT gateway translates IPv6 (diamonds) to IPv4 (circles) on the way out and back again on the way in.",
      "wide": true,
      "w": 960,
      "h": 400,
      "dur": 12,
      "poster": 0.489,
      "groups": [
        { "kind": "cloud", "x": 8, "y": 8, "w": 836, "h": 365 },
        { "kind": "region", "x": 20, "y": 34, "w": 812, "h": 327, "label": "Region" },
        { "kind": "vpc", "x": 32, "y": 58, "w": 712, "h": 291, "label": "VPC", "note": ["10.0.0.0/16", "2001:db8:1200::/56"] },
        { "kind": "az", "x": 168, "y": 92, "w": 562, "h": 160, "label": "Availability Zone A" },
        { "kind": "priv", "x": 180, "y": 116, "w": 278, "h": 124, "label": "IPv6-only subnet", "note": "2001:db8:1200:21::/64" },
        { "kind": "pub", "x": 470, "y": 116, "w": 248, "h": 124, "note": ["10.0.1.0/24", "2001:db8:1200:1::/64"] }
      ],
      "nodes": [
        { "id": "res", "icon": "aws-res-route-53-resolver", "x": 84, "y": 164, "size": 32, "label": "Route 53 VPC Resolver", "wrap": 12, "sub": "fd00:ec2::253" },
        { "id": "ec2", "icon": "aws-res-ec2-instance", "x": 234, "y": 164, "size": 32, "label": "Amazon EC2", "sub": "2001:db8:1200:21::10" },
        { "id": "nat", "icon": "aws-res-vpc-nat-gateway", "x": 524, "y": 164, "size": 32, "label": "NAT gateway", "sub": "10.0.1.20" },
        { "id": "igw", "icon": "aws-res-vpc-internet-gateway", "x": 768, "y": 164, "size": 32, "label": "Internet gateway" },
        { "id": "srv", "icon": "aws-res-server", "x": 890, "y": 164, "size": 32, "label": "IPv4-only server", "sub": "198.51.100.10" }
      ],
      "wires": [
        { "id": "q", "d": "M230,180 H120", "both": true },
        { "id": "a", "d": "M270,180 H520", "both": true },
        { "id": "b", "d": "M560,180 H764", "both": true },
        { "id": "c", "d": "M804,180 H886", "both": true }
      ],
      "flows": [
        {
          "id": "dns",
          "wires": [
            { "wire": "q", "ring": "res", "f": 0.8, "text": "A Nitro instance in the IPv6-only subnet receives an IPv6 address and no IPv4 address. It asks the Route 53 VPC Resolver, at fd00:ec2::253, for the AAAA record of legacy.example.com." },
            { "wire": "q", "ring": "ec2", "reverse": true, "kind": "pk-2", "f": 0.8, "dy": 11, "text": "The name has only an A record, 198.51.100.10. DNS64 is enabled on the subnet, so the Resolver synthesizes an AAAA answer by prepending 64:ff9b::/96 to that address: 64:ff9b::c633:640a." }
          ],
          "v6": true
        },
        {
          "id": "data",
          "wires": [
            { "wire": "a", "ring": "nat", "v6": true, "f": 0.12, "text": "The instance sends IPv6 traffic to 64:ff9b::c633:640a. The subnet route table sends 64:ff9b::/96 to the NAT gateway in the public subnet. NAT64 is built into every NAT gateway, and its subnet does not need to be dual-stack." },
            { "wire": "b", "ring": "igw", "f": 0.2, "text": "The NAT gateway does NAT64: it replaces the IPv6 source with its own private IPv4 address and takes the IPv4 destination from the last 32 bits of the address. It sends the IPv4 packet by the 0.0.0.0/0 route of the public route table to the internet gateway." },
            { "wire": "c", "ring": "srv", "f": 0.75, "text": "The internet gateway maps the private address of the NAT gateway to its Elastic IP address, and the packet reaches the IPv4-only server." },
            { "wire": "c", "reverse": true, "ring": "igw", "kind": "pk-2", "step": false },
            { "wire": "b", "reverse": true, "ring": "nat", "kind": "pk-2", "step": false },
            { "wire": "a", "reverse": true, "ring": "ec2", "kind": "pk-2", "step": true, "v6": true, "f": 0.12, "dy": 11, "text": "The server answers over IPv4. The NAT gateway translates the response back to IPv6, with 64:ff9b::c633:640a as its source, and delivers it to the instance over the local route." }
          ]
        }
      ],
      "notes": [
        { "x": 188, "y": 152, "text": "DNS64 enabled", "anchor": "start", "size": 9 },
        { "x": 392, "y": 174, "text": "to 64:ff9b::c633:640a", "kind": "label", "t": [0.277, 0.424], "tone": "request", "size": 8.5 },
        { "x": 650, "y": 174, "text": "to 198.51.100.10", "kind": "label", "t": [0.429, 0.548], "tone": "request", "size": 8.5 },
        { "x": 650, "y": 174, "text": "from 198.51.100.10", "kind": "label", "t": [0.659, 0.779], "tone": "response", "size": 8.5 }
      ],
      "tables": [
        {
