        { "n": 3, "x": 440, "y": 303, "text": "The Application Load Balancer sends all requests to the EC2 instances in Availability Zone b." },
        { "n": 4, "x": 770, "y": 300, "text": "Amazon RDS fails over: the standby in Availability Zone b becomes the primary, and the DB endpoint now resolves to it." }
      ],
