        { "id": "alb2", "icon": "aws-res-elastic-load-balancing-application-load-balancer", "x": 284, "y": 192, "size": 32, "label": "Application Load Balancer" },
        { "id": "ec2", "icon": "aws-res-ec2-instances", "x": 394, "y": 192, "size": 32, "label": "Amazon EC2", "sub": "app v2" }
      ],
      "wires": [
        { "id": "dq", "d": "M30,128 V66 H106", "dashed": true, "both": true },
        { "id": "p1", "d": "M52,144 H176 V100 H280" },
