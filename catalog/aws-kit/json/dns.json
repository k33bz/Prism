        { "kind": "gen", "x": 258, "y": 164, "w": 194, "h": 96, "label": "Canary (v2)" }
      ],
      "nodes": [
        { "id": "users", "icon": "aws-res-users", "x": 12, "y": 132, "size": 36, "label": "Users" },
