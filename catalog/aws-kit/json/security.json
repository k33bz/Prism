        { "kind": "priv", "x": 44, "y": 80, "w": 312, "h": 220, "label": "Private subnet", "note": "10.0.1.0/24" },
        { "kind": "sg", "x": 56, "y": 104, "w": 112, "h": 90, "label": "sg-app" },
        { "kind": "sg", "x": 232, "y": 104, "w": 112, "h": 90, "label": "sg-vpce" }
      ],
      "nodes": [
        { "id": "ec2", "icon": "aws-res-ec2-instance", "x": 96, "y": 130, "size": 32, "label": "Amazon EC2" },
        { "id": "eni", "icon": "aws-res-vpc-endpoints", "x": 272, "y": 130, "size": 32, "label": "Interface endpoint", "wrap": 20, "sub": "ENI 10.0.1.25" },
        { "id": "rt", "icon": "aws-res-route-53-route-table", "x": 96, "y": 236, "size": 32, "label": "Route table", "sub": "pl-0a1b2c3d > vpce" },
        { "id": "gwe", "icon": "aws-res-vpc-endpoints", "x": 388, "y": 236, "size": 32, "label": "Gateway endpoint", "wrap": 18, "sub": "no security group" },
        { "id": "pl", "icon": "aws-svc-privatelink", "x": 484, "y": 130, "size": 32, "label": "AWS PrivateLink" },
